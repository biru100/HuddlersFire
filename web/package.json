{
  "name": "huddlers-fire",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --import ./tests/sprite-fixture.mjs --test --test-concurrency=4 tests/release.test.mjs tests/camp.test.mjs tests/features.test.mjs tests/playback.test.mjs tests/character.test.mjs tests/weapons.test.mjs tests/carry-handoff.test.mjs tests/architecture.test.mjs tests/input.test.mjs tests/wire.test.mjs tests/community.test.mjs tests/view.test.mjs tests/playground.test.mjs tests/maps.test.mjs tests/immersion.test.mjs tests/exhibition.test.mjs tests/appearance.test.mjs tests/theme.test.mjs tests/sprites.test.mjs tests/sprite-pipeline.test.mjs tests/scene-composition.test.mjs tests/lighting.test.mjs tests/materials.test.mjs tests/avatar-proxy.test.mjs tests/material-review.test.mjs tests/pixel-pipeline.test.mjs tests/art-direction.test.mjs tests/art-intake.test.mjs tests/motion-lookdev.test.mjs tests/art-source-registry.test.mjs tests/deployment.test.mjs tests/motion-analysis.test.mjs tests/rounded02-lineage.test.mjs",
    "test:network": "node tests/network.integration.mjs",
    "test:render": "node --import ./tests/sprite-fixture.mjs tests/render-scene.mjs",
    "test:metrics": "node tests/measure-camp.mjs",
    "test:metrics:p2p": "node tests/measure-p2p-applied.mjs",
    "test:deployment": "node --test tests/deployment.test.mjs",
    "deploy": "node scripts/deploy-cloudflare.mjs",
    "deploy:check": "node scripts/deploy-cloudflare.mjs --dry-run",
    "typecheck": "tsc --noEmit",
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:browser:community": "node tests/browser.community.mjs",
    "test:browser:exhibition": "node tests/browser.exhibition.mjs",
    "test:browser:appearance": "node tests/browser.appearance.mjs",
    "test:qa-server": "node tests/local-immersion-server.mjs",
    "test:render:metrics": "node --import ./tests/sprite-fixture.mjs tests/measure-render.mjs outputs/sprite-render-after.json",
    "sprites:build": "node ../tools/rebuild-sprites.mjs",
    "test:sprites:pipeline": "node --import ./tests/sprite-fixture.mjs --test tests/sprite-pipeline.test.mjs tests/scene-composition.test.mjs tests/materials.test.mjs tests/material-review.test.mjs tests/pixel-pipeline.test.mjs tests/art-direction.test.mjs tests/art-intake.test.mjs tests/motion-lookdev.test.mjs tests/art-source-registry.test.mjs tests/motion-analysis.test.mjs tests/rounded02-lineage.test.mjs",
    "test:render:preview": "node tests/render-scene-preview.mjs",
    "test:browser:lighting": "node tests/browser.lighting.mjs",
    "materials:build": "node ../tools/build-material-maps.mjs",
    "test:browser:lighting:ui": "node tests/browser.lighting-ui.mjs",
    "test:browser:lighting:metrics": "node tests/browser.lighting-metrics.mjs",
    "test:browser:pixel": "node tests/browser.pixel.mjs",
    "test:art-direction": "node --test tests/art-direction.test.mjs",
    "test:art-intake": "node --test tests/art-intake.test.mjs",
    "test:browser:art-review": "node tests/browser.art-review.mjs",
    "test:motion-lookdev": "node --test tests/motion-lookdev.test.mjs tests/motion-analysis.test.mjs tests/rounded02-lineage.test.mjs",
    "test:art-source-registry": "node --test tests/art-source-registry.test.mjs",
    "test:browser:motion-review": "node tests/browser.motion-review.mjs"
  },
  "dependencies": {
    "@karrotmarket/react-monochrome-icon": "^1.33.0",
    "@seed-design/css": "3.1.0",
    "@seed-design/react": "3.1.1",
    "@seed-design/tailwind4-theme": "3.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "pixi.js": "8.14.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@napi-rs/canvas": "1.1.0",
    "@seed-design/vite-plugin": "2.1.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "werift": "0.26.0",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
